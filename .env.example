# Copy to .env and fill in. .env is gitignored; this file is the committed template.

# Lichess personal API token (lichess.org/account/oauth/token) — no scopes needed for public games
LICHESS_TOKEN=
# Whose games to fetch. Keep in sync with lichess_username in chess_dbt/dbt_project.yml
LICHESS_USERNAME=

PG_HOST=localhost
PG_PORT=5432
PG_DB=chess_analytics
PG_USER=
PG_PASSWORD=

# Databricks (optional — only for `dbt --target databricks` and scripts/load_databricks.py)
# Token: workspace > user icon > Settings > Developer > Access tokens
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
